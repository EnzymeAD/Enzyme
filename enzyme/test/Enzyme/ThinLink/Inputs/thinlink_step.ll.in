; Module of the time step @step for thinlink_checkpoint.ll (not a test itself).

; The step's state: a COMMON block it writes.
@state_ = common global [16 x i8] zeroinitializer

define void @step(ptr %x) {
  %v = load double, ptr %x
  %m = fmul double %v, %v
  store double %m, ptr %x
  store double %m, ptr @state_
  ret void
}
