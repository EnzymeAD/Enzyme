// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt %s --enzyme-wrap="infn=memref outfn= argTys=enzyme_dup,enzyme_const retTys=enzyme_dup mode=ForwardMode" --enzyme-wrap="infn=llvm outfn= argTys=enzyme_dup,enzyme_const retTys=enzyme_dup mode=ForwardMode" --canonicalize | FileCheck %s

// Storing an active value into inactive memory: nothing differentiates the
// memory, so there is no shadow to write and only the primal store remains.

module {
  func.func @memref(%x: f64, %m: memref<f64>) -> f64 {
    memref.store %x, %m[] : memref<f64>
    %r = arith.mulf %x, %x : f64
    return %r : f64
  }
  func.func @llvm(%x: f64, %p: !llvm.ptr) -> f64 {
    llvm.store %x, %p : f64, !llvm.ptr
    %r = arith.mulf %x, %x : f64
    return %r : f64
  }
}

// CHECK-LABEL:   func.func @memref(
// CHECK-SAME:                      %[[ARG0:[a-zA-Z0-9$._-]+]]: f64,
// CHECK-SAME:                      %[[ARG1:[a-zA-Z0-9$._-]+]]: f64,
// CHECK-SAME:                      %[[ARG2:[a-zA-Z0-9$._-]+]]: memref<f64>) -> (f64, f64) {
// CHECK:           memref.store %[[ARG0]], %[[ARG2]][] : memref<f64>
// CHECK:           %[[MULF_0:.*]] = arith.mulf %[[ARG1]], %[[ARG0]] fastmath<fast> : f64
// CHECK:           %[[MULF_1:.*]] = arith.mulf %[[ARG1]], %[[ARG0]] fastmath<fast> : f64
// CHECK:           %[[ADDF_0:.*]] = arith.addf %[[MULF_0]], %[[MULF_1]] fastmath<fast> : f64
// CHECK:           %[[MULF_2:.*]] = arith.mulf %[[ARG0]], %[[ARG0]] : f64
// CHECK:           return %[[MULF_2]], %[[ADDF_0]] : f64, f64
// CHECK:         }

// CHECK-LABEL:   func.func @llvm(
// CHECK-SAME:                    %[[ARG0:[a-zA-Z0-9$._-]+]]: f64,
// CHECK-SAME:                    %[[ARG1:[a-zA-Z0-9$._-]+]]: f64,
// CHECK-SAME:                    %[[ARG2:[a-zA-Z0-9$._-]+]]: !llvm.ptr) -> (f64, f64) {
// CHECK:           llvm.store %[[ARG0]], %[[ARG2]] : f64, !llvm.ptr
// CHECK:           %[[MULF_0:.*]] = arith.mulf %[[ARG1]], %[[ARG0]] fastmath<fast> : f64
// CHECK:           %[[MULF_1:.*]] = arith.mulf %[[ARG1]], %[[ARG0]] fastmath<fast> : f64
// CHECK:           %[[ADDF_0:.*]] = arith.addf %[[MULF_0]], %[[MULF_1]] fastmath<fast> : f64
// CHECK:           %[[MULF_2:.*]] = arith.mulf %[[ARG0]], %[[ARG0]] : f64
// CHECK:           return %[[MULF_2]], %[[ADDF_0]] : f64, f64
// CHECK:         }
