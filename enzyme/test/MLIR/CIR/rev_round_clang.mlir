// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme --canonicalize --remove-unnecessary-enzyme-ops --canonicalize %s | FileCheck %s

// Flattened output of clang -fclangir -emit-cir -O0 -fno-math-errno for
//   double rnd(double x) {
//     return floor(x) + x * round(x) + trunc(x) * rint(x)
//          + (double)lround(x) + (double)signbit(x);
//   }

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
module {
  cir.func @rnd(%arg0: !cir.double) -> !cir.double {
    %0 = cir.alloca "x" align(8) init : !cir.ptr<!cir.double>
    %1 = cir.alloca "__retval" align(8) : !cir.ptr<!cir.double>
    cir.store %arg0, %0 : !cir.double, !cir.ptr<!cir.double>
    %2 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %3 = cir.floor %2 : !cir.double
    %4 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %5 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %6 = cir.round %5 : !cir.double
    %7 = cir.fmuladd %4, %6, %3 : !cir.double
    %8 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %9 = cir.trunc %8 : !cir.double
    %10 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %11 = cir.rint %10 : !cir.double
    %12 = cir.fmuladd %9, %11, %7 : !cir.double
    %13 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %14 = cir.lround %13 : !cir.double -> !s64i
    %15 = cir.cast int_to_float %14 : !s64i -> !cir.double
    %16 = cir.fadd %12, %15 : !cir.double
    %17 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %18 = cir.signbit %17 : !cir.double -> !cir.bool
    %19 = cir.cast bool_to_int %18 : !cir.bool -> !s32i
    %20 = cir.cast int_to_float %19 : !s32i -> !cir.double
    %21 = cir.fadd %16, %20 : !cir.double
    cir.store %21, %1 : !cir.double, !cir.ptr<!cir.double>
    %22 = cir.load %1 : !cir.ptr<!cir.double>, !cir.double
    cir.return %22 : !cir.double
  }
  cir.func @rev(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @rnd(%x, %dr) { activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] } : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

