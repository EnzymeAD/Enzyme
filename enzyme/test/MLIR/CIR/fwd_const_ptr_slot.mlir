// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme %s | FileCheck %s

// At -O0 clang spills every argument to a stack slot. The slot of a constant
// pointer holds only constant data, so it gets no shadow and the tangent
// reads nothing through it: d(a[0] * k) = a[0] * dk.
module {
  cir.func @scal(%a: !cir.ptr<!cir.double>, %k: !cir.double) -> !cir.double {
    %aslot = cir.alloca "a" align(8) init : !cir.ptr<!cir.ptr<!cir.double>>
    %kslot = cir.alloca "k" align(8) init : !cir.ptr<!cir.double>
    cir.store %a, %aslot : !cir.ptr<!cir.double>, !cir.ptr<!cir.ptr<!cir.double>>
    cir.store %k, %kslot : !cir.double, !cir.ptr<!cir.double>
    %p = cir.load %aslot : !cir.ptr<!cir.ptr<!cir.double>>, !cir.ptr<!cir.double>
    %v = cir.load %p : !cir.ptr<!cir.double>, !cir.double
    %kv = cir.load %kslot : !cir.ptr<!cir.double>, !cir.double
    %r = cir.fmul %v, %kv : !cir.double
    cir.return %r : !cir.double
  }
  cir.func @dscal(%a: !cir.ptr<!cir.double>, %k: !cir.double, %dk: !cir.double) -> !cir.double {
    %r = enzyme.fwddiff @scal(%a, %k, %dk) <{ activity=[#enzyme.activity<enzyme_const>, #enzyme.activity<enzyme_dup>], ret_activity=[#enzyme.activity<enzyme_dupnoneed>] }> : (!cir.ptr<!cir.double>, !cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

// CHECK-LABEL:   cir.func private @fwddiffescal(
// CHECK-SAME:      %[[ARG0:[a-zA-Z0-9$._-]+]]: !cir.ptr<!cir.double>,
// CHECK-SAME:      %[[ARG1:[a-zA-Z0-9$._-]+]]: !cir.double,
// CHECK-SAME:      %[[ARG2:[a-zA-Z0-9$._-]+]]: !cir.double) -> !cir.double {
// CHECK:           %[[ALLOCA_0:.*]] = cir.alloca "a" align(8) init : !cir.ptr<!cir.ptr<!cir.double>>
// CHECK:           %[[ALLOCA_1:.*]] = cir.alloca "k" align(8) init : !cir.ptr<!cir.double>
// CHECK:           %[[ALLOCA_2:.*]] = cir.alloca "k" align(8) init : !cir.ptr<!cir.double>
// CHECK:           cir.store %[[ARG0]], %[[ALLOCA_0]] : !cir.ptr<!cir.double>, !cir.ptr<!cir.ptr<!cir.double>>
// CHECK:           cir.store %[[ARG2]], %[[ALLOCA_1]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           cir.store %[[ARG1]], %[[ALLOCA_2]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[LOAD_0:.*]] = cir.load %[[ALLOCA_0]] : !cir.ptr<!cir.ptr<!cir.double>>, !cir.ptr<!cir.double>
// CHECK:           %[[LOAD_1:.*]] = cir.load %[[LOAD_0]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[LOAD_2:.*]] = cir.load %[[ALLOCA_1]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[LOAD_3:.*]] = cir.load %[[ALLOCA_2]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[FMUL_0:.*]] = cir.fmul %[[LOAD_2]], %[[LOAD_1]] : !cir.double
// CHECK:           %[[FMUL_1:.*]] = cir.fmul %[[LOAD_1]], %[[LOAD_3]] : !cir.double
// CHECK:           cir.return %[[FMUL_0]] : !cir.double
// CHECK:         }
