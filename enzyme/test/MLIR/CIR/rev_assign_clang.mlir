    cir.store %arg0, %2 : !cir.double, !cir.ptr<!cir.double>
    %3 = cir.get_member %1[1] {name = ""} : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!cir.double>
    cir.store %arg1, %3 : !cir.double, !cir.ptr<!cir.double>
    %4 = cir.load %1 : !cir.ptr<!rec_anon_struct>, !rec_anon_struct
    cir.store %4, %0 : !rec_anon_struct, !cir.ptr<!rec_anon_struct>
    %5 = cir.cast bitcast %0 : !cir.ptr<!rec_anon_struct> -> !cir.ptr<!rec_P>
    %6 = cir.load %5 : !cir.ptr<!rec_P>, !rec_P
    %7 = cir.alloca "p" align(8) init : !cir.ptr<!rec_P>
    %8 = cir.alloca "__retval" align(8) : !cir.ptr<!cir.double>
    %9 = cir.alloca "q" align(8) init : !cir.ptr<!rec_P>
    cir.store %6, %7 : !rec_P, !cir.ptr<!rec_P>
    cir.copy %7 align(8) to %9 align(8) : !cir.ptr<!rec_P>
    %10 = cir.get_member %9[0] {name = "x"} : !cir.ptr<!rec_P> -> !cir.ptr<!cir.double>
    %11 = cir.load align(8) %10 : !cir.ptr<!cir.double>, !cir.double
    %12 = cir.get_member %9[1] {name = "y"} : !cir.ptr<!rec_P> -> !cir.ptr<!cir.double>
    %13 = cir.load align(8) %12 : !cir.ptr<!cir.double>, !cir.double
    %14 = cir.fmul %11, %13 : !cir.double
    cir.store %14, %8 : !cir.double, !cir.ptr<!cir.double>
    %15 = cir.load %8 : !cir.ptr<!cir.double>, !cir.double
    cir.return %15 : !cir.double
  }
  cir.func @dassign(%x: !cir.double, %y: !cir.double, %dr: !cir.double) -> !rec_anon_struct {
    %r = enzyme.autodiff @assign(%x, %y, %dr) { activity=[#enzyme.activity<enzyme_active>, #enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] } : (!cir.double, !cir.double, !cir.double) -> !rec_anon_struct
    cir.return %r : !rec_anon_struct
  }
}

