// Flattened output of clang -fclangir -emit-cir -O0 -fno-math-errno for
//   struct P { double x, y; };
//   double assign(struct P p) { struct P q = p; return q.x * q.y; }

!rec_P = !cir.struct<"P" {data !cir.double, data !cir.double}>
!rec_anon_struct = !cir.struct<{data !cir.double, data !cir.double}>
module {
  cir.func @assign(%arg0: !cir.double, %arg1: !cir.double) -> !cir.double {
