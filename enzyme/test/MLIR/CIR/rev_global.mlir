// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme --canonicalize --remove-unnecessary-enzyme-ops --canonicalize %s | FileCheck %s

// @g names its shadow, so its adjoint accumulates into @g_shadow. @c and
// @last have no shadow but are static: @c is only read, so it is constant,
// and @last is only written, so nothing active comes back out. @n is an int.
//   static double c = 5.0, last;
//   double read(double x) { return x * g * c * n; }
//   double write(double x) { g = x; return g * g; }
//   double logged(double x) { last = x; return x * x; }
// @s is static and only read, yet it names a shadow, so it is still active:
// the shadow asks for the derivative with respect to @s.
//   static double s = 4.0;  // enzyme_shadow = @s_shadow
//   double scaled(double x) { return x * s; }

!s32i = !cir.int<s, 32>
module {
  cir.global external @g = #cir.fp<3.000000e+00> : !cir.double {enzyme_shadow = @g_shadow}
  cir.global external @g_shadow = #cir.fp<0.000000e+00> : !cir.double
  cir.global "private" internal @c = #cir.fp<5.000000e+00> : !cir.double
  cir.global "private" internal @last = #cir.fp<0.000000e+00> : !cir.double
  cir.global "private" internal @s = #cir.fp<4.000000e+00> : !cir.double {enzyme_shadow = @s_shadow}
  cir.global external @s_shadow = #cir.fp<0.000000e+00> : !cir.double
  cir.global external @n = #cir.int<2> : !s32i
  cir.func @read(%x: !cir.double) -> !cir.double {
    %gp = cir.get_global @g : !cir.ptr<!cir.double>
    %g = cir.load %gp : !cir.ptr<!cir.double>, !cir.double
    %0 = cir.fmul %x, %g : !cir.double
    %cp = cir.get_global @c : !cir.ptr<!cir.double>
    %c = cir.load %cp : !cir.ptr<!cir.double>, !cir.double
    %1 = cir.fmul %0, %c : !cir.double
    %np = cir.get_global @n : !cir.ptr<!s32i>
    %n = cir.load %np : !cir.ptr<!s32i>, !s32i
    %nf = cir.cast int_to_float %n : !s32i -> !cir.double
    %2 = cir.fmul %1, %nf : !cir.double
    cir.return %2 : !cir.double
  }
  cir.func @write(%x: !cir.double) -> !cir.double {
    %0 = cir.get_global @g : !cir.ptr<!cir.double>
    cir.store %x, %0 : !cir.double, !cir.ptr<!cir.double>
    %1 = cir.get_global @g : !cir.ptr<!cir.double>
    %2 = cir.load %1 : !cir.ptr<!cir.double>, !cir.double
    %3 = cir.fmul %2, %2 : !cir.double
    cir.return %3 : !cir.double
  }
  cir.func @logged(%x: !cir.double) -> !cir.double {
    %0 = cir.get_global @last : !cir.ptr<!cir.double>
    cir.store %x, %0 : !cir.double, !cir.ptr<!cir.double>
    %1 = cir.fmul %x, %x : !cir.double
    cir.return %1 : !cir.double
  }
  cir.func @scaled(%x: !cir.double) -> !cir.double {
    %0 = cir.get_global @s : !cir.ptr<!cir.double>
    %1 = cir.load %0 : !cir.ptr<!cir.double>, !cir.double
    %2 = cir.fmul %x, %1 : !cir.double
    cir.return %2 : !cir.double
  }
  cir.func @dread(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @read(%x, %dr) <{ activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
  cir.func @dwrite(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @write(%x, %dr) <{ activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
  cir.func @dlogged(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @logged(%x, %dr) <{ activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
  cir.func @dscaled(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @scaled(%x, %dr) <{ activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

