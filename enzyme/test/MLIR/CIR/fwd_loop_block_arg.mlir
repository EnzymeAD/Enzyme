// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme %s | FileCheck %s

// After mem2reg a loop carries its values as block arguments. The active sum
// comes before the constant counter, so its tangent is inserted in the middle
// of a block that already has predecessors: d(n * x) = n * dx.
!s32i = !cir.int<s, 32>
module {
  cir.func @f(%x: !cir.double, %n: !s32i) -> !cir.double {
    %zero = cir.const #cir.int<0> : !s32i
    %fz = cir.const #cir.fp<0.000000e+00> : !cir.double
    cir.br ^bb1(%fz, %zero : !cir.double, !s32i)
  ^bb1(%s: !cir.double, %i: !s32i):
    %c = cir.cmp lt %i, %n : !s32i
    cir.brcond %c ^bb2, ^bb3
  ^bb2:
    %s2 = cir.fadd %s, %x : !cir.double
    %i2 = cir.inc %i : !s32i
    cir.br ^bb1(%s2, %i2 : !cir.double, !s32i)
  ^bb3:
    cir.return %s : !cir.double
  }
  cir.func @df(%x: !cir.double, %dx: !cir.double, %n: !s32i) -> !cir.double {
    %r = enzyme.fwddiff @f(%x, %dx, %n) <{ activity=[#enzyme.activity<enzyme_dup>, #enzyme.activity<enzyme_const>], ret_activity=[#enzyme.activity<enzyme_dupnoneed>] }> : (!cir.double, !cir.double, !s32i) -> !cir.double
    cir.return %r : !cir.double
  }
}

// CHECK-LABEL:   cir.func private @fwddiffef(
// CHECK-SAME:      %[[ARG0:[a-zA-Z0-9$._-]+]]: !cir.double,
// CHECK-SAME:      %[[ARG1:[a-zA-Z0-9$._-]+]]: !cir.double,
// CHECK-SAME:      %[[ARG2:[a-zA-Z0-9$._-]+]]: !s32i) -> !cir.double {
// CHECK:           %[[CONST_0:.*]] = cir.const #cir.int<0> : !s32i
// CHECK:           %[[CONST_1:.*]] = cir.const #cir.fp<0.000000e+00> : !cir.double
// CHECK:           %[[CONST_2:.*]] = cir.const #cir.fp<0.000000e+00> : !cir.double
// CHECK:           cir.br ^bb1(%[[CONST_1]], %[[CONST_2]], %[[CONST_0]] : !cir.double, !cir.double, !s32i)
// CHECK:         ^bb1(%[[VAL_0:.*]]: !cir.double, %[[VAL_1:.*]]: !cir.double, %[[VAL_2:.*]]: !s32i):
// CHECK:           %[[CMP_0:.*]] = cir.cmp lt %[[VAL_2]], %[[ARG2]] : !s32i
// CHECK:           cir.brcond %[[CMP_0]] ^bb2, ^bb3
// CHECK:         ^bb2:
// CHECK:           %[[FADD_0:.*]] = cir.fadd %[[VAL_1]], %[[ARG1]] : !cir.double
// CHECK:           %[[FADD_1:.*]] = cir.fadd %[[VAL_0]], %[[ARG0]] : !cir.double
// CHECK:           %[[INC_0:.*]] = cir.inc %[[VAL_2]] : !s32i
// CHECK:           cir.br ^bb1(%[[FADD_1]], %[[FADD_0]], %[[INC_0]] : !cir.double, !cir.double, !s32i)
// CHECK:         ^bb3:
// CHECK:           cir.return %[[VAL_1]] : !cir.double
// CHECK:         }
