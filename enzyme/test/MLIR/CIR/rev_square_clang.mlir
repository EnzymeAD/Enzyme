// CHECK:           cir.store %[[FADD_6]], %[[ALLOCA_0]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[LOAD_6:.*]] = cir.load %[[ALLOCA_0]] : !cir.ptr<!cir.double>, !cir.double
