// CHECK-SAME:      %[[ARG1:[a-zA-Z0-9$._-]+]]: !cir.double) -> !cir.double {
// CHECK:           %[[CONST_0:.*]] = cir.const #cir.fp<0.000000e+00> : !cir.double
// CHECK:           %[[ALLOCA_0:.*]] = cir.alloca "x" align(8) init : !cir.ptr<!cir.double>
// CHECK:           cir.store %[[CONST_0]], %[[ALLOCA_0]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[ALLOCA_1:.*]] = cir.alloca "x" align(8) init : !cir.ptr<!cir.double>
// CHECK:           %[[ALLOCA_2:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!cir.double>
// CHECK:           cir.store %[[CONST_0]], %[[ALLOCA_2]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[ALLOCA_3:.*]] = cir.alloca "__retval" align(8) : !cir.ptr<!cir.double>
// CHECK:           cir.store %[[ARG0]], %[[ALLOCA_1]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[LOAD_0:.*]] = cir.load align(8) %[[ALLOCA_1]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[LOAD_1:.*]] = cir.load align(8) %[[ALLOCA_1]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[FMUL_0:.*]] = cir.fmul %[[LOAD_0]], %[[LOAD_1]] : !cir.double
// CHECK:           cir.store %[[FMUL_0]], %[[ALLOCA_3]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[FADD_0:.*]] = cir.fadd %[[CONST_0]], %[[ARG1]] : !cir.double
// CHECK:           %[[LOAD_2:.*]] = cir.load %[[ALLOCA_2]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[FADD_1:.*]] = cir.fadd %[[LOAD_2]], %[[FADD_0]] : !cir.double
// CHECK:           cir.store %[[FADD_1]], %[[ALLOCA_2]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[LOAD_3:.*]] = cir.load %[[ALLOCA_2]] : !cir.ptr<!cir.double>, !cir.double
