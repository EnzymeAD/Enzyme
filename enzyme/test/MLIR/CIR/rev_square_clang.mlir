// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme --canonicalize --remove-unnecessary-enzyme-ops --canonicalize %s | FileCheck %s

// Flattened output of clang -fclangir -emit-cir -O0 -fno-math-errno for
//   double square(double x) { return x * x; }

module {
  cir.func @square(%arg0: !cir.double ) -> !cir.double {
    %0 = cir.alloca "x" align(8) init : !cir.ptr<!cir.double>
    %1 = cir.alloca "__retval" align(8) : !cir.ptr<!cir.double>
    cir.store %arg0, %0 : !cir.double, !cir.ptr<!cir.double>
    %2 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %3 = cir.load align(8) %0 : !cir.ptr<!cir.double>, !cir.double
    %4 = cir.fmul %2, %3 : !cir.double
    cir.store %4, %1 : !cir.double, !cir.ptr<!cir.double>
    %5 = cir.load %1 : !cir.ptr<!cir.double>, !cir.double
    cir.return %5 : !cir.double
  }
  cir.func @dsquare(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @square(%x, %dr) { activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] } : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

