// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py UTC_ARGS: --filter='^(d|f)_'
// RUN: %eopt --cir-raise-enzyme-calls %s | FileCheck %s

// The __enzyme_autodiff/__enzyme_fwddiff calls clang emits, with the markers
// loaded from their globals, become enzyme.autodiff/enzyme.fwddiff ops.

!s32i = !cir.int<s, 32>
!void = !cir.void
!rec_anon_struct = !cir.struct<{data !cir.double, data !cir.double}>
!rec_Grad2 = !cir.struct<"Grad2" {data !cir.double, data !cir.double}>
module {
  cir.global "private" external @enzyme_const : !s32i
  cir.global "private" external @enzyme_dup : !s32i
  cir.global "private" external @enzyme_out : !s32i
  cir.global "private" external @enzyme_primal_return : !s32i

  cir.func @mul(%x: !cir.double, %y: !cir.double) -> !cir.double {
    %r = cir.fmul %x, %y : !cir.double
    cir.return %r : !cir.double
  }
  cir.func @halfsq(%x: !cir.float) -> !cir.float {
    %r = cir.fmul %x, %x : !cir.float
    cir.return %r : !cir.float
  }
  cir.func @sum(%a: !cir.ptr<!cir.double>, %n: !s32i) -> !cir.double {
    %v = cir.load %a : !cir.ptr<!cir.double>, !cir.double
    cir.return %v : !cir.double
  }
  cir.func private @__enzyme_autodiff(!cir.ptr<!void>, ...) -> !cir.double
  cir.func private @__enzyme_autodiff_2(!cir.ptr<!void>, ...) -> !rec_Grad2
  cir.func private @__enzyme_fwddiff(!cir.ptr<!void>, ...) -> !cir.double

  // A float without a marker is active, and the float return is seeded.
  cir.func @d_default(%x: !cir.double, %y: !cir.double) -> !cir.double {
    %f = cir.get_global @mul : !cir.ptr<!cir.func<(!cir.double, !cir.double) -> !cir.double>>
    %fp = cir.cast bitcast %f : !cir.ptr<!cir.func<(!cir.double, !cir.double) -> !cir.double>> -> !cir.ptr<!void>
    %cg = cir.get_global @enzyme_const : !cir.ptr<!s32i>
    %c = cir.load %cg : !cir.ptr<!s32i>, !s32i
    %r = cir.call @__enzyme_autodiff(%fp, %x, %c, %y) : (!cir.ptr<!void>, !cir.double, !s32i, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }

  // Two gradients come back packed; the struct the program declares has the
  // same layout and is read back through memory.
  cir.func @d_struct(%x: !cir.double, %y: !cir.double) -> !rec_Grad2 {
    %f = cir.get_global @mul : !cir.ptr<!cir.func<(!cir.double, !cir.double) -> !cir.double>>
    %fp = cir.cast bitcast %f : !cir.ptr<!cir.func<(!cir.double, !cir.double) -> !cir.double>> -> !cir.ptr<!void>
    %og = cir.get_global @enzyme_out : !cir.ptr<!s32i>
    %o = cir.load %og : !cir.ptr<!s32i>, !s32i
    %r = cir.call @__enzyme_autodiff_2(%fp, %o, %x, %y) : (!cir.ptr<!void>, !s32i, !cir.double, !cir.double) -> !rec_Grad2
    cir.return %r : !rec_Grad2
  }

  // enzyme_dup takes a shadow; an int without a marker is constant. The
  // result is unused, so nothing replaces it.
  cir.func @d_dup(%a: !cir.ptr<!cir.double>, %da: !cir.ptr<!cir.double>, %n: !s32i) {
    %f = cir.get_global @sum : !cir.ptr<!cir.func<(!cir.ptr<!cir.double>, !s32i) -> !cir.double>>
    %fp = cir.cast bitcast %f : !cir.ptr<!cir.func<(!cir.ptr<!cir.double>, !s32i) -> !cir.double>> -> !cir.ptr<!void>
    %dg = cir.get_global @enzyme_dup : !cir.ptr<!s32i>
    %d = cir.load %dg : !cir.ptr<!s32i>, !s32i
    %r = cir.call @__enzyme_autodiff(%fp, %d, %a, %da, %n) : (!cir.ptr<!void>, !s32i, !cir.ptr<!cir.double>, !cir.ptr<!cir.double>, !s32i) -> !cir.double
    cir.return
  }

  // C promotes a float passed to a variadic function to a double: it goes back
  // to a float for the parameter, and the float gradient becomes the double
  // the call returns.
  cir.func @d_promote(%x: !cir.double) -> !cir.double {
    %f = cir.get_global @halfsq : !cir.ptr<!cir.func<(!cir.float) -> !cir.float>>
    %fp = cir.cast bitcast %f : !cir.ptr<!cir.func<(!cir.float) -> !cir.float>> -> !cir.ptr<!void>
    %r = cir.call @__enzyme_autodiff(%fp, %x) : (!cir.ptr<!void>, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }

  // In forward mode a float is duplicated; enzyme_primal_return also returns
  // the primal, packed in front of the tangent.
  cir.func @f_primal(%x: !cir.double, %dx: !cir.double, %y: !cir.double) -> !rec_anon_struct {
    %f = cir.get_global @mul : !cir.ptr<!cir.func<(!cir.double, !cir.double) -> !cir.double>>
    %fp = cir.cast bitcast %f : !cir.ptr<!cir.func<(!cir.double, !cir.double) -> !cir.double>> -> !cir.ptr<!void>
    %pg = cir.get_global @enzyme_primal_return : !cir.ptr<!s32i>
    %p = cir.load %pg : !cir.ptr<!s32i>, !s32i
    %cg = cir.get_global @enzyme_const : !cir.ptr<!s32i>
    %c = cir.load %cg : !cir.ptr<!s32i>, !s32i
    %r = cir.call @__enzyme_fwddiff(%fp, %p, %x, %dx, %c, %y) : (!cir.ptr<!void>, !s32i, !cir.double, !cir.double, !s32i, !cir.double) -> !cir.double
    %s = cir.const #cir.zero : !rec_anon_struct
    cir.return %s : !rec_anon_struct
  }
}

