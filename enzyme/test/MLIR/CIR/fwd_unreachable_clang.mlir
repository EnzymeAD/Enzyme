// CHECK:           %[[ALLOCA_8:.*]] = cir.alloca "t" align(8) init : !cir.ptr<!cir.double>
// CHECK:           %[[ALLOCA_9:.*]] = cir.alloca "t" align(8) init : !cir.ptr<!cir.double>
// CHECK:           cir.store %[[ARG1]], %[[ALLOCA_2]] : !cir.double, !cir.ptr<!cir.double>
