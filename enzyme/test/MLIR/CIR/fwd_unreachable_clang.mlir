// CHECK:           %[[FMUL_3:.*]] = cir.fmul %[[FMUL_2]], %[[LOAD_7]] : !cir.double
// CHECK:           %[[FMUL_4:.*]] = cir.fmul %[[LOAD_6]], %[[SIN_0]] : !cir.double
// CHECK:           %[[FSUB_0:.*]] = cir.fsub %[[FMUL_3]], %[[FMUL_4]] : !cir.double
// CHECK:           %[[FMUL_5:.*]] = cir.fmul %[[LOAD_7]], %[[LOAD_7]] : !cir.double
