// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme --canonicalize --remove-unnecessary-enzyme-ops --canonicalize %s | FileCheck %s

// Flattened output of clang -fclangir -emit-cir -O1 -fno-math-errno for
//   #include <math.h>
//   double poly(double x, double y) { double t = x * y + 2.0; return sin(t) / x; }

!s32i = !cir.int<s, 32>
module {
  cir.func @poly(%arg0: !cir.double, %arg1: !cir.double) -> !cir.double {
    %0 = cir.const #cir.int<1> : !s32i
    %1 = cir.const #cir.fp<2.000000e+00> : !cir.double
    %2 = cir.alloca "__cleanup_dest_slot" align(4) cleanup_dest_slot : !cir.ptr<!s32i>
    %3 = cir.alloca "x" align(8) init : !cir.ptr<!cir.double>
    %4 = cir.alloca "y" align(8) init : !cir.ptr<!cir.double>
    %5 = cir.alloca "__retval" align(8) : !cir.ptr<!cir.double>
    %6 = cir.alloca "t" align(8) init : !cir.ptr<!cir.double>
    cir.store %arg0, %3 : !cir.double, !cir.ptr<!cir.double>
    cir.store %arg1, %4 : !cir.double, !cir.ptr<!cir.double>
    cir.lifetime.start %6 : !cir.ptr<!cir.double>
    %7 = cir.load align(8) %3 : !cir.ptr<!cir.double>, !cir.double
    %8 = cir.load align(8) %4 : !cir.ptr<!cir.double>, !cir.double
    %9 = cir.fmuladd %7, %8, %1 : !cir.double
    cir.store align(8) %9, %6 : !cir.double, !cir.ptr<!cir.double>
    %10 = cir.load align(8) %6 : !cir.ptr<!cir.double>, !cir.double
    %11 = cir.sin %10 : !cir.double
    %12 = cir.load align(8) %3 : !cir.ptr<!cir.double>, !cir.double
    %13 = cir.fdiv %11, %12 : !cir.double
    cir.store %13, %5 : !cir.double, !cir.ptr<!cir.double>
    cir.store %0, %2 : !s32i, !cir.ptr<!s32i>
    cir.lifetime.end %6 : !cir.ptr<!cir.double>
    %14 = cir.load %2 : !cir.ptr<!s32i>, !s32i
    cir.switch.flat %14 : !s32i, ^bb3 [
      0: ^bb1,
      1: ^bb2
    ]
  ^bb1:
    %15 = cir.load %5 : !cir.ptr<!cir.double>, !cir.double
    cir.return %15 : !cir.double
  ^bb2:
    %16 = cir.load %5 : !cir.ptr<!cir.double>, !cir.double
    cir.return %16 : !cir.double
  ^bb3:
    cir.unreachable
  }
  cir.func @fwd(%x: !cir.double, %dx: !cir.double, %y: !cir.double, %dy: !cir.double) -> !cir.double {
    %r = enzyme.fwddiff @poly(%x, %dx, %y, %dy) { activity=[#enzyme.activity<enzyme_dup>, #enzyme.activity<enzyme_dup>], ret_activity=[#enzyme.activity<enzyme_dupnoneed>] } : (!cir.double, !cir.double, !cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

