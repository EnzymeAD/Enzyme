// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme --canonicalize --remove-unnecessary-enzyme-ops --canonicalize %s | FileCheck %s

//   static double acc = 1.0;
//   double g = 3.0, g_shadow = 7.0;
//   double step(double x) { acc = x * acc; g = x; return g * acc; }

module {
  cir.global "private" internal dso_local @acc = #cir.fp<1.000000e+00> : !cir.double align(8)
  cir.global external @g = #cir.fp<3.000000e+00> : !cir.double
  cir.global external @g_shadow = #cir.fp<7.000000e+00> : !cir.double
  cir.func @step(%x: !cir.double) -> !cir.double {
    %0 = cir.get_global @acc : !cir.ptr<!cir.double>
    %1 = cir.load %0 : !cir.ptr<!cir.double>, !cir.double
    %2 = cir.fmul %x, %1 : !cir.double
    cir.store %2, %0 : !cir.double, !cir.ptr<!cir.double>
    %3 = cir.get_global @g : !cir.ptr<!cir.double>
    cir.store %x, %3 : !cir.double, !cir.ptr<!cir.double>
    %4 = cir.load %3 : !cir.ptr<!cir.double>, !cir.double
    %5 = cir.fmul %4, %2 : !cir.double
    cir.return %5 : !cir.double
  }
  cir.func @fstep(%x: !cir.double, %dx: !cir.double) -> !cir.double {
    %r = enzyme.fwddiff @step(%x, %dx) <{ activity=[#enzyme.activity<enzyme_dup>], ret_activity=[#enzyme.activity<enzyme_dupnoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
  cir.func @rstep(%x: !cir.double, %dr: !cir.double) -> !cir.double {
    %r = enzyme.autodiff @step(%x, %dr) <{ activity=[#enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

