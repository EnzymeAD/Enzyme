// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme --canonicalize --remove-unnecessary-enzyme-ops --canonicalize %s | FileCheck %s

//   cops(z, w) = (z * w) / w + conj(z) - w

module {
  cir.func @cops(%z: !cir.complex<!cir.double>, %w: !cir.complex<!cir.double>) -> !cir.complex<!cir.double> {
    %0 = cir.complex.mul %z, %w range(basic) : !cir.complex<!cir.double>
    %1 = cir.complex.div %0, %w range(improved) : !cir.complex<!cir.double>
    %2 = cir.complex.conj %z : !cir.complex<!cir.double>
    %3 = cir.complex.add %1, %2 : !cir.complex<!cir.double>
    %4 = cir.complex.sub %3, %w : !cir.complex<!cir.double>
    cir.return %4 : !cir.complex<!cir.double>
  }
  cir.func @rev_cops(%a0: !cir.complex<!cir.double>, %a1: !cir.complex<!cir.double>, %dr: !cir.complex<!cir.double>) -> !cir.struct<{data !cir.complex<!cir.double>, data !cir.complex<!cir.double>}> {
    %r = enzyme.autodiff @cops(%a0, %a1, %dr) <{ activity=[#enzyme.activity<enzyme_active>, #enzyme.activity<enzyme_active>], ret_activity=[#enzyme.activity<enzyme_activenoneed>] }> : (!cir.complex<!cir.double>, !cir.complex<!cir.double>, !cir.complex<!cir.double>) -> !cir.struct<{data !cir.complex<!cir.double>, data !cir.complex<!cir.double>}>
    cir.return %r : !cir.struct<{data !cir.complex<!cir.double>, data !cir.complex<!cir.double>}>
  }
}

