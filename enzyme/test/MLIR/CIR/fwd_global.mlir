// NOTE: Assertions have been autogenerated by utils/update_mlir_test_checks.py
// RUN: %eopt --enzyme %s | FileCheck %s

// The tangent of @g lives in @g_shadow.
//   double write(double x) { g = x; return g * g; }

module {
  cir.global external @g = #cir.fp<3.000000e+00> : !cir.double {enzyme_shadow = @g_shadow}
  cir.global external @g_shadow = #cir.fp<0.000000e+00> : !cir.double
  cir.func @write(%x: !cir.double) -> !cir.double {
    %0 = cir.get_global @g : !cir.ptr<!cir.double>
    cir.store %x, %0 : !cir.double, !cir.ptr<!cir.double>
    %1 = cir.get_global @g : !cir.ptr<!cir.double>
    %2 = cir.load %1 : !cir.ptr<!cir.double>, !cir.double
    %3 = cir.fmul %2, %2 : !cir.double
    cir.return %3 : !cir.double
  }
  cir.func @dwrite(%x: !cir.double, %dx: !cir.double) -> !cir.double {
    %r = enzyme.fwddiff @write(%x, %dx) <{ activity=[#enzyme.activity<enzyme_dup>], ret_activity=[#enzyme.activity<enzyme_dupnoneed>] }> : (!cir.double, !cir.double) -> !cir.double
    cir.return %r : !cir.double
  }
}

// CHECK-LABEL:   cir.func private @fwddiffewrite(
// CHECK-SAME:      %[[ARG0:[a-zA-Z0-9$._-]+]]: !cir.double,
// CHECK-SAME:      %[[ARG1:[a-zA-Z0-9$._-]+]]: !cir.double) -> !cir.double {
// CHECK:           %[[GET_GLOBAL_0:.*]] = cir.get_global @g_shadow : !cir.ptr<!cir.double>
// CHECK:           %[[GET_GLOBAL_1:.*]] = cir.get_global @g : !cir.ptr<!cir.double>
// CHECK:           cir.store %[[ARG1]], %[[GET_GLOBAL_0]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           cir.store %[[ARG0]], %[[GET_GLOBAL_1]] : !cir.double, !cir.ptr<!cir.double>
// CHECK:           %[[GET_GLOBAL_2:.*]] = cir.get_global @g_shadow : !cir.ptr<!cir.double>
// CHECK:           %[[GET_GLOBAL_3:.*]] = cir.get_global @g : !cir.ptr<!cir.double>
// CHECK:           %[[LOAD_0:.*]] = cir.load %[[GET_GLOBAL_2]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[LOAD_1:.*]] = cir.load %[[GET_GLOBAL_3]] : !cir.ptr<!cir.double>, !cir.double
// CHECK:           %[[FMUL_0:.*]] = cir.fmul %[[LOAD_0]], %[[LOAD_1]] : !cir.double
// CHECK:           %[[FMUL_1:.*]] = cir.fmul %[[LOAD_0]], %[[LOAD_1]] : !cir.double
// CHECK:           %[[FADD_0:.*]] = cir.fadd %[[FMUL_0]], %[[FMUL_1]] : !cir.double
// CHECK:           %[[FMUL_2:.*]] = cir.fmul %[[LOAD_1]], %[[LOAD_1]] : !cir.double
// CHECK:           cir.return %[[FADD_0]] : !cir.double
// CHECK:         }
