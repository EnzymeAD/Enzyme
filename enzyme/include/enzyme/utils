        template <typename T, typename... Args>
        struct verify_dup_args {
          static constexpr bool value = true;
        };

        template <bool ReturnPrimal, typename... Args>
        struct verify_dup_args<ReverseMode<ReturnPrimal>, Args...> {
          static constexpr bool value = (
            (
              !type_info<remove_cvref_t<Args>>::is_duplicated
              || std::is_reference_v<typename type_info<remove_cvref_t<Args>>::type>
              || std::is_pointer_v<typename type_info<remove_cvref_t<Args>>::type>
            ) && ...
          );
        };

        template<class T>
        struct is_function_or_function_ptr : std::is_function<T> {};
         
        template<class T>
        struct is_function_or_function_ptr<T*> : std::is_function<T> {};

        template <typename Param, typename Arg>
        struct is_abi_compatible_arg {
          static constexpr bool value =
              std::is_same_v<Param, Arg> ||
              (std::is_lvalue_reference_v<Param> &&
               std::is_lvalue_reference_v<Arg> &&
               std::is_convertible_v<Arg, Param> &&
               std::is_same_v<remove_cvref_t<Param>, remove_cvref_t<Arg>>) ||
              (std::is_rvalue_reference_v<Param> &&
               std::is_rvalue_reference_v<Arg> &&
               std::is_convertible_v<Arg, Param> &&
               std::is_same_v<remove_cvref_t<Param>, remove_cvref_t<Arg>>);
        };

        template <typename Param, typename Arg>
        struct is_abi_compatible_arg<Param*, Arg*> {
          static constexpr bool value =
              std::is_convertible_v<Arg*, Param*> &&
              is_abi_compatible_arg<std::remove_cv_t<Param>,
                                    std::remove_cv_t<Arg>>::value;
        };

        template <typename Fn, typename Functy, typename Enable = void>
        struct is_abi_compatible_func : std::false_type {};

        template <typename R1, typename... P1, typename R2, typename... P2>
        struct is_abi_compatible_func<
            R1(P1...), R2(P2...),
            std::enable_if_t<sizeof...(P1) == sizeof...(P2)>> {
          static constexpr bool value =
              std::is_same_v<R1, R2> &&
              (is_abi_compatible_arg<P1, P2>::value && ...);
        };

        template <typename R1, typename... P1, typename R2, typename... P2>
        struct is_abi_compatible_func<R1(P1...) noexcept, R2(P2...)>
            : is_abi_compatible_func<R1(P1...), R2(P2...)> {};

        template <typename Fn, typename Functy>
        struct is_abi_compatible_func<Fn*, Functy>
            : is_abi_compatible_func<Fn, Functy> {};

        template <typename T>
        struct wrapped_callable {
          static constexpr bool is_wrapped = false;
        };

        template <typename Fn>
        struct wrapped_callable<Duplicated<Fn>> {
          static constexpr bool is_wrapped = true;
          using fn_type = std::remove_reference_t<Fn>;
          __attribute__((always_inline))
          static fn_type* value_ptr(const Duplicated<Fn>& w) {
            if constexpr (std::is_reference_v<Fn>) {
              return w.value;
            } else {
              return const_cast<fn_type*>(&w.value);
            }
          }
          __attribute__((always_inline))
          static fn_type* shadow_ptr(const Duplicated<Fn>& w) {
            if constexpr (std::is_reference_v<Fn>) {
              return w.shadow;
            } else {
              return const_cast<fn_type*>(&w.shadow);
            }
          }
          __attribute__((always_inline))
          static auto expand_primals(const Duplicated<Fn>& w) {
            return enzyme::tuple{enzyme_dup, static_cast<const void*>(value_ptr(w))};
          }
          __attribute__((always_inline))
          static auto expand_shadows(const Duplicated<Fn>& w) {
            return enzyme::tuple{static_cast<const void*>(shadow_ptr(w))};
          }
        };

        template <typename Fn>
        struct wrapped_callable<DuplicatedNoNeed<Fn>> {
          static constexpr bool is_wrapped = true;
          using fn_type = std::remove_reference_t<Fn>;
          __attribute__((always_inline))
          static fn_type* value_ptr(const DuplicatedNoNeed<Fn>& w) {
            if constexpr (std::is_reference_v<Fn>) {
              return w.value;
            } else {
              return const_cast<fn_type*>(&w.value);
            }
          }
          __attribute__((always_inline))
          static fn_type* shadow_ptr(const DuplicatedNoNeed<Fn>& w) {
            if constexpr (std::is_reference_v<Fn>) {
              return w.shadow;
            } else {
              return const_cast<fn_type*>(&w.shadow);
            }
          }
          __attribute__((always_inline))
          static auto expand_primals(const DuplicatedNoNeed<Fn>& w) {
            return enzyme::tuple{enzyme_dupnoneed, static_cast<const void*>(value_ptr(w))};
          }
          __attribute__((always_inline))
          static auto expand_shadows(const DuplicatedNoNeed<Fn>& w) {
            return enzyme::tuple{static_cast<const void*>(shadow_ptr(w))};
          }
        };

        template <typename Fn>
        struct wrapped_callable<Const<Fn>> {
          static constexpr bool is_wrapped = true;
          using fn_type = std::remove_reference_t<Fn>;
          __attribute__((always_inline))
          static fn_type* value_ptr(const Const<Fn>& w) {
            if constexpr (std::is_reference_v<Fn>) {
              return w.value;
            } else {
              return const_cast<fn_type*>(&w.value);
            }
          }
          __attribute__((always_inline))
          static auto expand_primals(const Const<Fn>& w) {
            return enzyme::tuple{enzyme_const, static_cast<const void*>(value_ptr(w))};
          }
          __attribute__((always_inline))
          static auto expand_shadows(const Const<Fn>&) {
            return enzyme::tuple{};
          }
        };
    }  // namespace detail

    template < typename return_type, typename function, typename ... enz_arg_types >
    __attribute__((always_inline))
    auto primal_impl(function && f, enzyme::tuple< enz_arg_types ... > && arg_tup) {
      using Tuple = enzyme::tuple< enz_arg_types ... >;
      return detail::primal_apply_impl<return_type>(std::move(f), impl::forward<Tuple>(arg_tup), std::make_index_sequence<enzyme::tuple_size_v<Tuple>>{});
    }

    template < typename function, typename ... arg_types, std::enable_if_t<!detail::wrapped_callable<remove_cvref_t<function>>::is_wrapped, int> = 0>
    auto primal_call(function && f, arg_types && ... args) {
        return primal_impl<function>(impl::forward<function>(f), enzyme::forward_as_tuple(enzyme::get<0>(primal_args(args))...));
    }

    template < typename function, typename ... arg_types, std::enable_if_t<detail::wrapped_callable<remove_cvref_t<function>>::is_wrapped, int> = 0>
    auto primal_call(function && f, arg_types && ... args) {
        using WC = detail::wrapped_callable<remove_cvref_t<function>>;
        auto* fp = WC::value_ptr(f);
        return primal_impl<typename WC::fn_type&>(*fp, enzyme::forward_as_tuple(enzyme::get<0>(primal_args(args))...));
    }

    template < typename return_type, typename DiffMode, typename function, typename functy, typename RetActivity, typename ... enz_arg_types, std::enable_if_t<!detail::is_function_or_function_ptr<typename remove_cvref< function >::type>::value, int> = 0>
    __attribute__((always_inline))
    auto autodiff_impl(function && f, enzyme::tuple< enz_arg_types ... > && arg_tup) {
      using Tuple = enzyme::tuple< enz_arg_types ... >;
      using FnObj = std::remove_reference_t<function>;
      return detail::autodiff_apply<DiffMode>::template impl<return_type>((void*)&detail::templated_call<FnObj, functy>::wrap, detail::ret_global<RetActivity>::value,
            impl::forward<Tuple>(arg_tup),
            std::make_index_sequence<enzyme::tuple_size_v<Tuple>>{}, &enzyme_const, static_cast<const void*>(&f));
    }

    template < typename return_type, typename DiffMode, typename function, typename functy, typename RetActivity, typename ... enz_arg_types, std::enable_if_t<detail::is_function_or_function_ptr<typename remove_cvref< function >::type>::value, int> = 0>
    __attribute__((always_inline))
    auto autodiff_impl(function && f, enzyme::tuple< enz_arg_types ... > && arg_tup) {
      using Tuple = enzyme::tuple< enz_arg_types ... >;
      void* fn_ptr;
      if constexpr (detail::is_abi_compatible_func<typename remove_cvref<function>::type, functy>::value) {
        fn_ptr = reinterpret_cast<void*>(+f);
      } else {
        fn_ptr = (void*)static_cast<functy*>(f);
      }
      return detail::autodiff_apply<DiffMode>::template impl<return_type>(fn_ptr, detail::ret_global<RetActivity>::value, impl::forward<Tuple>(arg_tup), std::make_index_sequence<enzyme::tuple_size_v<Tuple>>{});
    }

    template < typename DiffMode, typename RetActivity, typename function, typename ... arg_types, std::enable_if_t<!detail::wrapped_callable<remove_cvref_t<function>>::is_wrapped, int> = 0>
    __attribute__((always_inline))
    auto autodiff(function && f, arg_types && ... args) {
        static_assert(
            detail::verify_dup_args<DiffMode, arg_types...>::value,
            "Non-reference/pointer Duplicated/DuplicatedNoNeed args don't make "
            "sense for Reverse mode AD"
        );
        using primal_return_type = decltype(f(arg_type(args)...));
        using functy = typename detail::function_type<primal_return_type, decltype(arg_type(args))...>::type;
        using return_type = typename autodiff_return<DiffMode, RetActivity, arg_types...>::type;
        return autodiff_impl<return_type, DiffMode, function, functy, RetActivity>(impl::forward<function>(f), enzyme::tuple_cat(enzyme::tuple{detail::ret_used<DiffMode, RetActivity>::value}, expand_primals(args)..., enzyme::tuple{enzyme_interleave}, expand_shadows(args)...));
    }

