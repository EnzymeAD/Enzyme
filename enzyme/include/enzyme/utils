        >::type>;
    };

    template < typename RetType, typename ... T >
    struct autodiff_return<ReverseMode<true>, RetType, T...>
    {
        using type = tuple<
            typename primal_ret_type<RetType>::type,
            typename concatenated< tuple< >,
                typename grad_out_type<
                    typename remove_cvref< T >::type
                >::type ...
            >::type
        >;
    };

