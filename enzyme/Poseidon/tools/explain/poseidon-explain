"""Present what Poseidon changed, considered and rejected, from the
<func>.explain.json files a compile writes with -poseidon-explain=<dir>."""

import argparse
import difflib
import json
import os
import re
import shutil
import subprocess
import sys

SCHEMA_ID = "poseidon-explain/1"

STATUS_ORDER = {"applied": 0, "pareto": 1, "rejected": 2}

# Seconds the AST clang of --format source/diff may run.
CLANG_TIMEOUT_S = 120


def fail(message):
    """Ends the run with `poseidon-explain: <message>` and exit status 1."""
    sys.exit("poseidon-explain: " + message)


def fmt_number(v, digits=2):
    """`v` to `digits` significant digits, or n/a when it is unknown."""
    if v is None:
        return "n/a"
    return "%.*g" % (digits, v)


def fmt_cost(v):
    """A cost: a share of what the profiled run spent in the site."""
    return fmt_number(v, 6)


def short_loc(loc):
    """`loc` as file:line:col with the file's directory left out."""
    if not loc:
        return "?"
    return "%s:%d:%d" % (os.path.basename(loc.get("file", "")), loc.get("line", 0), loc.get("col", 0))


def clip(s, n=160):
    """`s` cut to `n` characters."""
    return s if len(s) <= n else s[:n] + "..."


def load(paths):
    """The explanations in `paths`, files or directories of .explain.json
    files; an unreadable or malformed file ends the run."""
    docs = []
    for p in paths:
        files = []
        if os.path.isdir(p):
            files = sorted(os.path.join(p, f) for f in os.listdir(p) if f.endswith(".explain.json"))
        else:
            files = [p]
        for f in files:
            try:
                with open(f) as fh:
                    doc = json.load(fh)
            except OSError as e:
                fail("cannot read %s: %s" % (f, e.strerror))
            except ValueError as e:
                fail("%s is not JSON: %s" % (f, e))
            if not isinstance(doc, dict) or doc.get("schema") != SCHEMA_ID:
                fail("%s is not a %s file" % (f, SCHEMA_ID))
            docs.append(doc)
    if not docs:
        fail("no .explain.json found in %s" % " ".join(paths))
    return docs


def alternative_c(alt):
    """The C form of an alternative, its outputs' forms joined by "; "."""
    c = alt.get("c")
    if isinstance(c, list):
        return "; ".join(c)
    return c or ""


def alternative_words(alt):
    """What an alternative does, in the words a report lists it by."""
    if alt.get("kind") in ("precision", "expansion") or isinstance(alt.get("c"), list):
        return alt.get("summary", "")
    return alternative_c(alt) or alt.get("summary", "")


def technique(unit, alt):
    """The note on how an alternative approximates, with the range it holds on."""
    note = alt.get("approx_note", "")
    if "series approximation" in note and ranges(unit):
        note += ", valid on the profiled range " + ", ".join(ranges(unit))
    return note


def outputs_c(unit):
    """The C forms of a unit's outputs as written."""
    orig = unit.get("original", {}).get("c")
    if isinstance(orig, list):
        return orig
    return [orig] if orig else []


def fmt_range(lo, hi):
    """[lo, hi] to the fewest significant digits, at least 3, that tell the two
    apart."""
    digits = 3
    while lo != hi and digits < 17 and fmt_number(lo, digits) == fmt_number(hi, digits):
        digits += 1
    return "[%s, %s]" % (fmt_number(lo, digits), fmt_number(hi, digits))


def ranges(unit):
    """The profiled range of each named input of a unit."""
    out = []
    for inp in unit.get("inputs", []):
        label = inp.get("name") or inp.get("var")
        if label and "min" in inp:
            out.append("%s in %s" % (label, fmt_range(inp["min"], inp["max"])))
    return out


def target_words(doc):
    """The accuracy target or the cost budget a site was solved under."""
    t = doc.get("target", {})
    if "tau" in t:
        src = " (the site's own)" if t.get("tau_from") == "site" else ""
        return "accuracy target tau = %s%s" % (fmt_number(t["tau"], 3), src)
    return "cost budget %s" % fmt_cost(t.get("budget", 0))


def select_flag(doc, point):
    """The flags that select the frontier point `point` again."""
    t = doc.get("target", {})
    ids = ",".join(point.get("applied", []))
    # A point without a budget is one no budget selects.
    if t.get("tau_from") == "site" or "budget" not in point:
        return "-poseidon-pin=%s" % ids if ids else "(as written)"
    budget = float(point["budget"])
    flag = "-poseidon-cost-budget=%s" % (int(budget) if budget.is_integer() else repr(budget))
    if "tau" in t:
        flag = "-poseidon-tau=0 " + flag
    return flag


def rank(alt):
    """The order a report lists alternatives in: applied, on the frontier,
    rejected; cheaper first; more accurate first."""
    r = STATUS_ORDER.get(alt.get("status"), 3)
    cheaper = alt.get("cost_delta", 0) < 0
    return (r, 0 if cheaper else 1, alt.get("modelled_error", float("inf")))


def report_header(doc, emit):
    """The site, its target and the solve's result. False for a site that was
    not solved, which has nothing more to report."""
    fn = doc["function"]
    res = doc.get("result", {})
    emit("Poseidon site %s  [%s]" % (fn.get("name"), fn.get("symbol")))
    if fn.get("site"):
        emit("  called at %s" % short_loc(fn["site"]))
    t = doc.get("target", {})
    if "selector" not in t:
        emit("  %s; %s: %s" % (target_words(doc), res.get("status", "?").replace("_", " "), res.get("reason", "")))
        if res.get("profile"):
            emit("  profile: %s" % res["profile"])
        return False
    emit("  %s; cost model %s; selector %s%s" % (target_words(doc), os.path.basename(t.get("cost_model", "")),
                                             t.get("selector", "?"), "; DP table from the cache" if t.get("from_cache") else ""))
    before, after = res.get("cost_before"), res.get("cost_after")
    emit("  as written:   modelled error %s, cost %s" % (fmt_number(res.get("modelled_rel_error_as_written")),
                                                        fmt_cost(before)))
    pct = ""
    if before and after is not None:
        pct = " (%+.0f%%)" % (100.0 * (after - before) / before)
    applied = res.get("applied", [])
    emit("  with Poseidon: modelled error %s, cost %s%s; applied %s" % (
        fmt_number(res.get("modelled_rel_error")), fmt_cost(after), pct,
        ", ".join(applied) if applied else "nothing"))
    if res.get("reason"):
        emit("  %s: %s" % (res.get("status", "?").replace("_", " "), res["reason"]))
    return True


def report_unit(unit, args, emit):
    """One optimization unit: what it computes, its profile, what was applied
    and what else was considered."""
    emit("")
    outs = outputs_c(unit)
    where = short_loc(unit.get("loc"))
    if unit.get("kind") == "matmul":
        emit("%s  %s: the %s matrix product" % (where, unit["id"], unit.get("shape", "?")))
    else:
        emit("%s  %s: %s" % (where, unit["id"], outs[0] if outs else "?"))
        for k, o in enumerate(unit.get("outputs", [])[1:], 1):
            emit("%s  %s  output %d (%s): %s" % (" " * len(where), " " * len(unit["id"]), k,
                                                short_loc(o.get("loc")), o.get("c", "")))
    facts = ranges(unit)
    profile = ", ".join(facts) + "; " if facts else ""
    profile += "%s executions" % unit.get("executions", 0)
    if unit.get("ops"):
        profile += "; %d operations" % len(unit["ops"])
    if unit.get("cost") is not None:
        profile += "; cost %s" % fmt_cost(unit["cost"])
    emit("  profile: %s" % profile)
    alts = sorted(unit.get("alternatives", []), key=rank)
    for a in [a for a in alts if a.get("status") == "applied"]:
        emit("  applied %s (%s%s): %s" % (a.get("id"), a.get("kind"),
                                         ", " + a["precision"] if a.get("precision") else "",
                                         clip(alternative_words(a), 400)))
        detail = []
        if technique(unit, a):
            detail.append(technique(unit, a))
        if "modelled_error" in a:
            detail.append("modelled error %s" % fmt_number(a["modelled_error"]))
        if "modelled_domain_error" in a:
            detail.append("modelled domain error %s" % fmt_number(a["modelled_domain_error"]))
        if "cost_delta" in a:
            detail.append("cost change %s" % fmt_cost(a["cost_delta"]))
        emit("      %s" % "; ".join(d for d in detail if d))
    if unit.get("left_as_written"):
        emit("  left as written: %s" % unit["left_as_written"])
    others = [a for a in alts if a.get("status") != "applied"]
    shown = others if args.all else others[:args.max]
    if shown:
        emit("  considered:")
        emit("    %-8s %-9s %-10s %9s %12s  %s" % ("id", "status", "kind", "error", "cost change", "rewrite / reason"))
        for a in shown:
            err = a.get("modelled_error", a.get("modelled_domain_error"))
            emit("    %-8s %-9s %-10s %9s %12s  %s" % (a.get("id", "-"), a.get("status"), a.get("kind"),
                                                    fmt_number(err), fmt_cost(a.get("cost_delta")),
                                                    clip(alternative_words(a), 100)))
            emit("    %-8s %-9s %-10s %9s %12s    %s" % ("", "", "", "", "", a.get("reason", "")))
    if len(others) > len(shown):
        emit("    ... %d more (--all)" % (len(others) - len(shown)))


def report_pareto(doc, emit):
    """The frontier, each point with the flags that select it."""
    pareto = doc.get("pareto", [])
    if not pareto:
        return
    emit("")
    emit("Pareto frontier (cost, modelled error; * = selected):")
    emit("    %12s %15s  %-24s %s" % ("cost", "modelled error", "rewrites", "select with"))
    for p in pareto:
        emit("  %s %12s %15s  %-24s %s" % ("*" if p.get("selected") else " ", fmt_cost(p.get("cost", p.get("budget"))),
                                          fmt_number(p.get("modelled_rel_error")),
                                          ",".join(p.get("applied", [])) or "(as written)", select_flag(doc, p)))
    if doc.get("target", {}).get("tau_from") != "site":
        emit("  -poseidon-pin=<ids> applies a point's rewrites directly.")


def report(doc, args, emit):
    """--format report: what a site's solve changed, considered and rejected."""
    if not report_header(doc, emit):
        return
    for unit in doc.get("subgraphs", []):
        report_unit(unit, args, emit)
    report_pareto(doc, emit)


def first_token_end(s):
    """The end of the first space-separated token of `s` outside parentheses."""
    depth = 0
    for m, ch in enumerate(s):
        depth += {"(": 1, ")": -1}.get(ch, 0)
        if ch == " " and depth == 0:
            return m
    return len(s)


def strip_types(expr):
    """An FPCore of Herbie's output with its typed literals, approximation
    wrappers and precision suffixes removed."""
    expr = re.sub(r"#s\(literal\s+(\S+)\s+\w+\)", r"\1", expr)
    out, i = [], 0
    while i < len(expr):
        if not expr.startswith("#s(approx", i):
            out.append(expr[i])
            i += 1
            continue
        depth, k = 1, i + 3
        while k < len(expr) and depth:
            depth += {"(": 1, ")": -1}.get(expr[k], 0)
            k += 1
        inner = expr[i + len("#s(approx"):k - 1].strip()
        out.append(strip_types(inner[first_token_end(inner):].strip()))
        i = k
    return re.sub(r"\(([^\s()]+)\.f(32|64)\b", r"(\1", "".join(out))


def budgets(doc, args, emit):
    """--format budgets: the shares a -poseidon-cost-budget selects the frontier
    points by, printed as the compiler prints a share it reads back exactly."""
    emit(",".join("%.17g" % p["budget"] for p in doc.get("pareto", []) if "budget" in p))


def fpcore(doc, args, emit):
    """--format fpcore: each subgraph and its algebraic alternatives as FPCores."""
    fn = doc["function"]
    for unit in doc.get("subgraphs", []):
        if unit.get("kind") != "subgraph":
            continue
        inputs = unit.get("inputs", [])
        pre = []
        for inp in inputs:
            if inp.get("var") and "min" in inp:
                pre.append("(<= %r %s %r)" % (inp["min"], inp["var"], inp["max"]))
        pre_s = pre[0] if len(pre) == 1 else "(and %s)" % " ".join(pre) if pre else "TRUE"
        args_s = " ".join(i["var"] for i in inputs if i.get("var"))
        emit(";; %s %s at %s" % (fn.get("name"), unit["id"], short_loc(unit.get("loc"))))
        for k, o in enumerate(unit.get("outputs", [])):
            if not o.get("fpcore"):
                continue
            emit("(FPCore (%s) :name \"%s output %d as written\" :precision binary64 :pre %s\n  %s)" % (
                args_s, unit["id"], k, pre_s, o["fpcore"]))
        for a in sorted(unit.get("alternatives", []), key=rank):
            if a.get("kind") != "algebraic" or not a.get("fpcore") or not a.get("id"):
                continue
            if a.get("status") == "rejected" and not args.all:
                continue
            body = a["fpcore"]
            prec = a.get("precision", "binary64")
            if "->" in body:
                emit(";; %s (%s), as Herbie returned it:\n;; %s" % (a["id"], a.get("status"), body))
                continue
            emit("(FPCore (%s) :name \"%s %s (%s)\" :precision %s :pre %s\n  %s)" % (
                args_s, unit["id"], a["id"], a.get("status"), prec, pre_s, strip_types(body)))
        emit("")


class Ast:
    """The nodes of clang's AST of a source file, each spanning [b, e) in the
    file's characters."""

    def __init__(self, nodes):
        self.nodes = nodes

    def covering(self, lo, hi, exprs_only=True):
        """The smallest node, an expression unless `exprs_only` is false, that
        spans [lo, hi)."""
        best = None
        for n in self.nodes:
            if n["b"] <= lo and n["e"] >= hi and (not exprs_only or n["expr"]):
                if best is None or (n["e"] - n["b"]) < (best["e"] - best["b"]):
                    best = n
        return best

    def statement_of(self, off):
        """The smallest statement that contains `off`."""
        best = None
        for n in self.nodes:
            if n["b"] <= off < n["e"] and n["stmt"]:
                if best is None or (n["e"] - n["b"]) < (best["e"] - best["b"]):
                    best = n
        return best

    def call_at(self, off):
        """The smallest call that starts at `off`."""
        cands = [n for n in self.nodes if n["b"] == off and n["kind"] in ("CallExpr", "CXXOperatorCallExpr")]
        return min(cands, key=lambda n: n["e"] - n["b"]) if cands else None

    def binop_at(self, off):
        """The smallest binary operator whose operator lies at `off`."""
        best = None
        for n in self.nodes:
            if n["kind"] in ("BinaryOperator", "CompoundAssignOperator") and len(n["kids"]) == 2:
                l, r = n["kids"]
                if l["e"] <= off < r["b"]:
                    if best is None or (n["e"] - n["b"]) < (best["e"] - best["b"]):
                        best = n
        return best

    def value_at(self, off):
        """The value read at `off`: its load when there is one, else the
        smallest expression that starts there."""
        cands = [n for n in self.nodes if n["b"] == off and n["expr"]]
        if not cands:
            return None
        loads = [n for n in cands if n["kind"] == "ImplicitCastExpr" and n["node"].get("castKind") == "LValueToRValue"]
        pool = loads or cands
        return max(pool, key=lambda n: n["e"] - n["b"]) if loads else min(pool, key=lambda n: n["e"] - n["b"])


STMT_KINDS = {"DeclStmt", "ReturnStmt", "IfStmt", "ForStmt", "WhileStmt", "DoStmt", "CompoundStmt"}


def is_expr_kind(kind):
    """Whether an AST node kind is an expression."""
    return kind.endswith("Expr") or kind.endswith("Operator") or kind.endswith("Literal")


def parse_ast(text, src, func):
    """The nodes of clang's JSON AST dump `text` that lie in the source `src`;
    output that is not JSON ends the run."""
    dec = json.JSONDecoder()
    docs, i = [], 0
    while i < len(text):
        while i < len(text) and text[i].isspace():
            i += 1
        if i >= len(text):
            break
        try:
            o, i = dec.raw_decode(text, i)
        except ValueError as e:
            fail("clang's AST of %s is not JSON: %s" % (func, e))
        docs.append(o)
    nodes = []
    state = {"file": None}

    # A location's character offset and file; clang leaves out the file of a
    # location in the file of the one before.
    def point(loc):
        if not isinstance(loc, dict):
            return None
        if "expansionLoc" in loc:
            point(loc.get("spellingLoc"))
            return None
        if "file" in loc:
            state["file"] = loc["file"]
        if "offset" not in loc:
            return None
        return src.char_of(loc["offset"]), src.char_of(loc["offset"] + loc.get("tokLen", 0)), state["file"]

    def same(f):
        if f is None:
            return False
        try:
            return os.path.samefile(f, src.path)
        except OSError:
            return os.path.basename(f) == os.path.basename(src.path)

    def walk(node, parent):
        point(node.get("loc"))
        rng = node.get("range", {})
        b = point(rng.get("begin"))
        e = point(rng.get("end"))
        me = None
        if b and e and same(b[2]) and same(e[2]) and node.get("kind"):
            kind = node["kind"]
            me = {"b": b[0], "e": e[1], "kind": kind, "node": node, "kids": [],
                  "expr": is_expr_kind(kind) and not (kind == "BinaryOperator" and node.get("opcode") in ("=", ",")),
                  "stmt": kind in STMT_KINDS or (parent is not None and parent["kind"] == "CompoundStmt")}
            nodes.append(me)
            if parent is not None:
                parent["kids"].append(me)
        for child in node.get("inner", []) or []:
            walk(child, me if me is not None else parent)

    for d in docs:
        walk(d, None)
    return Ast(nodes)


def default_clang():
    """The clang the poseidon-clang++ next to this tool runs, else clang++ or
    clang on PATH."""
    driver = os.path.join(os.path.dirname(os.path.realpath(__file__)), "poseidon-clang++")
    if os.access(driver, os.X_OK):
        try:
            p = subprocess.run([driver, "-print-prog-name=clang++"], stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, universal_newlines=True, timeout=CLANG_TIMEOUT_S)
            if p.returncode == 0 and os.path.isabs(p.stdout.strip()):
                return p.stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            pass
    return shutil.which("clang++") or shutil.which("clang")


def run_clang(src, func, args):
    """The AST of `func` in `src`, or None and the reason there is none."""
    clang = args.clang or default_clang()
    if not clang:
        return None, "no clang found (--clang)"
    extra = list(args.clang_arg or [])
    cmd = [clang, "-fsyntax-only", "-w", "-ferror-limit=0", "-Xclang", "-ast-dump=json",
           "-Xclang", "-ast-dump-filter=" + func] + extra + [src.path]
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True,
                           timeout=CLANG_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e)
    if not p.stdout.strip():
        return None, (p.stderr.strip().splitlines() or ["clang produced no AST"])[0]
    return parse_ast(p.stdout, src, func), None


class Source:
    """A source file. Its text is indexed by character, while clang and the
    explanation give byte offsets and columns."""

    def __init__(self, path):
        self.path = path
        with open(path, "rb") as fh:
            data = fh.read()
        self.text = data.decode("utf-8", errors="surrogateescape")
        self.char_index = None
        if len(self.text) != len(data):
            self.char_index = []
            for k, ch in enumerate(self.text):
                self.char_index += [k] * len(ch.encode("utf-8", errors="surrogateescape"))
            self.char_index.append(len(self.text))
        self.line_starts = [0]
        for m in re.finditer(b"\n", data):
            self.line_starts.append(m.end())

    def char_of(self, byte):
        """The character index of byte offset `byte`."""
        if self.char_index is None:
            return byte
        return self.char_index[min(byte, len(self.char_index) - 1)]

    def offset(self, loc):
        """The character index of a line and a byte column, or None."""
        if not loc or not loc.get("line"):
            return None
        line = loc["line"] - 1
        if line >= len(self.line_starts):
            return None
        return self.char_of(self.line_starts[line] + max(loc.get("col", 1), 1) - 1)

    def line_of(self, char):
        """The 1-based line of character index `char`."""
        return self.text.count("\n", 0, char) + 1

    def span(self, n):
        """The text of AST node `n`."""
        return self.text[n["b"]:n["e"]]


SIMPLE = re.compile(r"^([A-Za-z_]\w*(::\w+)*(\[[^\[\]]*\])*|[0-9.]+[fFlL]?|\([^()]*\))$")


def is_simple(t):
    """Whether a cast applies to C text `t` without parentheses around it."""
    return bool(SIMPLE.match(t.strip()))


def splice(src, node, replace):
    """The text of `node` with each child `replace` gives a text for replaced."""
    out, pos = [], node["b"]
    for kid in sorted(node["kids"], key=lambda k: k["b"]):
        if kid["b"] < pos:
            continue
        t = replace(kid)
        if t is None:
            continue
        out.append(src.text[pos:kid["b"]])
        out.append(t)
        pos = kid["e"]
    out.append(src.text[pos:node["e"]])
    return "".join(out)


def strip_casts(n):
    """`n` without the implicit casts and parentheses around it."""
    while n["kind"] in ("ImplicitCastExpr", "ParenExpr") and len(n["kids"]) == 1:
        n = n["kids"][0]
    return n


def is_mul(n):
    """Whether `n` is a multiplication."""
    n = strip_casts(n)
    return n["kind"] == "BinaryOperator" and n["node"].get("opcode") == "*" and len(n["kids"]) == 2


def precision_text(src, node, changed):
    """The C text of `node` with each operation of `changed` (node id -> (C
    type, the op the explanation lists for it)) computed in its C type, its
    operands cast to that type and its result to double."""

    def contains(n):
        return any(n["b"] <= c["b"] and c["e"] <= n["e"] for c in changed_nodes)

    def operand(n, ctype):
        t, ty = render(n, ctype)
        return t if ty == ctype else "(%s)%s" % (ctype, t if is_simple(t) else "(" + t + ")")

    # The text of `n` and the C type it is in, None for double: in `want`
    # when it is a changed operation feeding one of that type.
    def render(n, want):
        if id(n) in changed:
            ctype, op = changed[id(n)]
            l, r = (n["kids"] + [None, None])[:2]
            opchar = src.text[l["e"]:r["b"]].strip() if l and r else ""
            if op.get("opcode") == "fma" and opchar in ("+", "-") and (is_mul(l) or (opchar == "+" and is_mul(r))):
                mul, add = (strip_casts(l), r) if is_mul(l) else (strip_casts(r), l)
                a, b = (operand(k, ctype) for k in mul["kids"])
                c = operand(add, ctype)
                text = "fmaf(%s, %s, %s)" % (a, b, c if opchar == "+" else "-" + c)
            elif n["kind"] in ("CallExpr", "CXXOperatorCallExpr"):
                callee, call_args = n["kids"][0], n["kids"][1:]
                name = op.get("float_call") or src.span(callee).split("::")[-1].strip()
                text = "%s(%s)" % (name, ", ".join(operand(a, ctype) for a in call_args))
            else:
                text = "(%s %s %s)" % (operand(l, ctype), opchar, operand(r, ctype))
            if want is not None:
                return text, ctype
            return "(double)" + text, None
        if not contains(n):
            return src.span(n), None
        if n["kind"] == "ImplicitCastExpr" and len(n["kids"]) == 1 and n["kids"][0]["b"] == n["b"] and n["kids"][0]["e"] == n["e"]:
            return render(n["kids"][0], want)
        return splice(src, n, lambda k: render(k, None)[0] if contains(k) else None), None

    changed_nodes = [n for n in all_nodes(node) if id(n) in changed]
    return render(node, None)[0]


def all_nodes(n):
    """`n` and every node under it."""
    yield n
    for k in n["kids"]:
        yield from all_nodes(k)


def leaf_text(unit, src, ast):
    """The source text of each unnamed input of a unit, by its FPCore variable."""
    names = {}
    for inp in unit.get("inputs", []):
        if inp.get("name") or not inp.get("var"):
            continue
        off = src.offset(inp.get("loc"))
        n = ast.value_at(off) if (ast and off is not None) else None
        if n:
            names[inp["var"]] = src.span(n)
    return names


def substitute(text, names):
    """`text` with each FPCore variable of `names` replaced by its source text."""
    if not names:
        return text
    return re.sub(r"\b(v\d+)\b", lambda m: names.get(m.group(1), m.group(1)), text)


C_TYPES = {"FP32": ("float", "float"), "FP16": ("_Float16", "half"), "BF16": ("__bf16", "bfloat16")}


def algebraic_edits(unit, alt, tag, src, ast):
    """The edits of an applied algebraic alternative, one per output, and a
    note for an output with no expression in the AST to replace."""
    edits, notes = [], []
    ops, outs = unit.get("ops", []), unit.get("outputs", [])
    names = leaf_text(unit, src, ast)
    c = alt.get("c")
    for j, k in enumerate(alt.get("outputs", [])):
        o = outs[k] if k < len(outs) else {}
        text = c[j] if isinstance(c, list) else c
        root = src.offset(o.get("loc"))
        node = None
        if ast and text and root is not None:
            stmt = ast.statement_of(root)
            offs = [root]
            for i in o.get("ops", []):
                off = src.offset(ops[i].get("loc")) if i < len(ops) else None
                if off is not None and (stmt is None or stmt["b"] <= off < stmt["e"]):
                    offs.append(off)
            node = ast.covering(min(offs), max(offs) + 1)
        if node is not None:
            edits.append((node["b"], node["e"], substitute(text, names), tag))
        else:
            notes.append((o.get("loc") or unit.get("loc"), "%s -> %s" % (o.get("c", "?"), text or alt.get("fpcore")), tag))
    return edits, notes


def precision_edits(unit, alt, tag, src, ast):
    """The edits of an applied precision alternative, one per outermost changed
    operation, each operation in the C type of its own change; a note instead
    when an operation has no node in the AST."""
    ops = unit.get("ops", [])
    changed, order = {}, []
    for ch in alt.get("changes", []):
        ctype, words = C_TYPES.get(ch.get("to"), ("float", "float"))
        for i in ch.get("ops", []):
            off = src.offset(ops[i].get("loc")) if i < len(ops) else None
            n = None
            if ast and off is not None:
                infix = ops[i].get("opcode") in ("+", "-", "*", "/", "fma")
                n = ast.binop_at(off) if infix else ast.call_at(off)
            if n is None:
                return [], [(unit.get("loc"), alt.get("summary", ""), tag)]
            if id(n) not in changed:
                changed[id(n)] = (ctype, ops[i])
                order.append((n, words))
    if not changed:
        return [], [(unit.get("loc"), alt.get("summary", ""), tag)]
    edits = []
    for n, words in order:
        if any(m is not n and m["b"] <= n["b"] and n["e"] <= m["e"] for m, _ in order):
            continue
        inner = [changed[id(m)][1].get("opcode", "?") for m, _ in order if n["b"] <= m["b"] and m["e"] <= n["e"]]
        edits.append((n["b"], n["e"], precision_text(src, n, changed),
                      "Poseidon: %s in %s [%s]" % (", ".join(inner), words, alt.get("id"))))
    return edits, []


def edits_for(doc, src, ast):
    """The source edits of a site's applied alternatives, (begin, end, text,
    tag), and notes (loc, text, tag) for those with no place in the AST."""
    edits, notes = [], []
    for unit in doc.get("subgraphs", []):
        for a in unit.get("alternatives", []):
            if a.get("status") != "applied":
                continue
            what = a.get("approx_note") or ("algebraic rewrite at %s" % a.get("precision", "?"))
            tag = "Poseidon: %s [%s]" % (what if a.get("kind") == "algebraic" else a.get("summary", ""), a.get("id"))
            if "modelled_error" in a:
                tag += ", modelled error %s" % fmt_number(a["modelled_error"])
            if a.get("kind") == "algebraic":
                e, n = algebraic_edits(unit, a, tag, src, ast)
            elif a.get("kind") == "precision":
                e, n = precision_edits(unit, a, tag, src, ast)
            else:
                e, n = [], [(unit.get("loc"), a.get("summary", ""), tag)]
            edits += e
            notes += n
    return edits, notes


def source_of(doc, args):
    """The source file a site's explanation is of."""
    fn = doc["function"]
    return args.source or (fn.get("site") or fn.get("loc") or {}).get("file")


def site_ast(src, docs, args):
    """One AST of every site of `docs` in `src`, or None; a site clang gives
    no AST of is said on stderr, and its rewrites become comments."""
    nodes, seen = [], set()
    for doc in docs:
        fn = doc["function"]
        func = fn.get("name", "").split("(")[0] or fn.get("symbol", "")
        if func in seen:
            continue
        seen.add(func)
        ast, err = run_clang(src, func, args)
        if ast is None:
            sys.stderr.write("poseidon-explain: no AST of %s (%s); its rewrites are shown as comments\n" % (func, err))
            continue
        nodes += ast.nodes
    return Ast(nodes) if nodes else None


def apply_edits(src, edits, notes):
    """The source with `edits` applied, each tagged with a comment at the end of
    its line, and `notes` as comments above their lines. An edit that overlaps
    an earlier one is not applied, and becomes a note."""
    kept, last = [], -1
    for e in sorted(edits, key=lambda e: e[0]):
        if e[0] < last:
            notes.append(({"line": src.line_of(e[0])}, "not applied, it overlaps an earlier rewrite", e[3]))
            sys.stderr.write("poseidon-explain: %s overlaps an earlier rewrite; shown as a comment\n"
                             % e[3].split(" [", 1)[-1].split("]")[0])
            continue
        kept.append(e)
        last = e[1]
    out, pos, ends = [], 0, []
    length = 0
    for b, e, text, tag in kept:
        piece = src.text[pos:b]
        out.append(piece)
        length += len(piece)
        out.append(text)
        length += len(text)
        ends.append((length, tag))
        pos = e
    out.append(src.text[pos:])
    lines = "".join(out).split("\n")
    starts = [0]
    for line in lines[:-1]:
        starts.append(starts[-1] + len(line) + 1)
    line_tags = {}
    for end, tag in ends:
        line_no = max(i for i, s in enumerate(starts) if s <= max(end - 1, 0))
        line_tags.setdefault(line_no, [])
        if tag not in line_tags[line_no]:
            line_tags[line_no].append(tag)
    for line_no, tags in line_tags.items():
        lines[line_no] += "  // " + "; ".join(t.replace("Poseidon: ", "", 1) if k else t for k, t in enumerate(tags))
    above = {}
    for loc, text, tag in notes:
        if not loc:
            continue
        above.setdefault(loc["line"] - 1, []).append("%s: %s" % (tag.split(" [")[0], text) + " [" + tag.split(" [", 1)[-1])
    result = []
    for i, line in enumerate(lines):
        for n in above.get(i, []):
            indent = re.match(r"\s*", line).group(0)
            result.append("%s// %s" % (indent, n))
        result.append(line)
    return "\n".join(result)


def rewritten_source(path, docs, args):
    """The source `path` before and after the applied rewrites of `docs`."""
    if not path or not os.path.exists(path):
        fail("source file %s not found (--source)" % path)
    src = Source(path)
    ast = site_ast(src, docs, args)
    edits, notes = [], []
    for doc in docs:
        e, n = edits_for(doc, src, ast)
        edits += e
        notes += n
    return path, src.text, apply_edits(src, edits, notes)


FORMATS = {
    "report": "what each site's solve changed, considered and rejected",
    "source": "the source with the applied rewrites spliced in, through clang's AST",
    "diff": "the same as a unified diff against the source",
    "fpcore": "each subgraph and its algebraic alternatives as Herbie FPCores",
    "budgets": "the -poseidon-cost-budget values that select the frontier points",
}


def count(text):
    """A non-negative integer argument."""
    try:
        value = int(text)
    except ValueError:
        value = -1
    if value < 0:
        raise argparse.ArgumentTypeError("%r is not a non-negative integer" % text)
    return value


def main():
    ap = argparse.ArgumentParser(prog="poseidon-explain", description=__doc__)
    ap.add_argument("paths", nargs="+", help="<func>.explain.json files or directories holding them")
    ap.add_argument("--format", default="report", choices=list(FORMATS),
                    help="; ".join("%s: %s" % kv for kv in FORMATS.items()))
    ap.add_argument("--source", help="the source file (default: the file the explanation names)")
    ap.add_argument("--function", help="only the sites whose name, symbol or IR name contains this")
    ap.add_argument("--clang", help="clang used for the AST of --format source/diff (default: the one "
                                    "poseidon-clang++ runs)")
    ap.add_argument("--clang-arg", action="append", help="extra argument for that clang (repeatable)")
    ap.add_argument("--max", type=count, default=8, help="alternatives listed per subgraph in the report")
    ap.add_argument("--all", action="store_true", help="list every alternative")
    args = ap.parse_args()

    docs = load(args.paths)
    if args.function:
        docs = [d for d in docs if any(args.function in d["function"].get(k, "") for k in ("name", "symbol", "ir"))]
        if not docs:
            fail("no explanation in %s is of a site named like '%s'" % (" ".join(args.paths), args.function))
    out = sys.stdout.write

    def emit(line=""):
        out(line + "\n")

    if args.format in ("source", "diff"):
        groups = {}
        for doc in docs:
            groups.setdefault(source_of(doc, args), []).append(doc)
        for path, group in groups.items():
            path, old, new = rewritten_source(path, group, args)
            if not new.endswith("\n"):
                new += "\n"
            if args.format == "source":
                out(new)
            else:
                name = os.path.basename(path)
                out("".join(difflib.unified_diff(old.splitlines(True), new.splitlines(True), "a/" + name, "b/" + name)))
        return
    for k, doc in enumerate(docs):
        if args.format == "report":
            if k:
                emit("")
            report(doc, args, emit)
        elif args.format == "budgets":
            budgets(doc, args, emit)
        else:
            fpcore(doc, args, emit)


if __name__ == "__main__":
    main()
