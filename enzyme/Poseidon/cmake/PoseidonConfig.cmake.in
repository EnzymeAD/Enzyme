@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(MPFR)
include("${CMAKE_CURRENT_LIST_DIR}/PoseidonTargets.cmake")

set(POSEIDON_PLUGIN "$<TARGET_FILE:Poseidon::Poseidon-@LLVM_VERSION_MAJOR@>")
set(POSEIDON_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(POSEIDON_RUNTIME_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/poseidon/runtime")
set(POSEIDON_COST_MODEL_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/poseidon/cost_models")
set(POSEIDON_HERBIE_BINARY "@POSEIDON_HERBIE_BINARY_PATH@")
