# Writes OUT, the header naming this build of the pass and of its matrix
# accuracy model by the contents of their sources: the pass is its sources in
# PASS_DIR (PassSources.cmake; BINARY_DIR, if given, is the build directory to
# leave out), the model the comma-separated ACCURACY_FILES of PASS_DIR.
# EQUIVALENTS lists earlier model identities, one per line, whose results the
# current model reproduces.

include(${CMAKE_CURRENT_LIST_DIR}/PassSources.cmake)

# A digest of `lines`, as the header spells an identity.
function(poseidon_identity out_var lines)
  string(SHA256 _sha "${lines}")
  string(SUBSTRING ${_sha} 0 16 _sha)
  string(TOUPPER ${_sha} _sha)
  set(${out_var} ${_sha} PARENT_SCOPE)
endfunction()

poseidon_pass_sources(_pass ${PASS_DIR} "${BINARY_DIR}")
set(_lines "")
foreach(_file ${_pass})
  file(SHA256 ${PASS_DIR}/${_file} _sha)
  string(APPEND _lines "${_file} ${_sha}\n")
endforeach()
poseidon_identity(_pass_id "${_lines}")

# Contents only, so moving or renaming a model file keeps the identity.
string(REPLACE "," ";" _accuracy "${ACCURACY_FILES}")
set(_digests "")
foreach(_file ${_accuracy})
  file(SHA256 ${PASS_DIR}/${_file} _sha)
  list(APPEND _digests ${_sha})
endforeach()
list(SORT _digests)
list(JOIN _digests "\n" _lines)
poseidon_identity(_accuracy_id "${_lines}")

file(STRINGS ${EQUIVALENTS} _equivalents REGEX "^[0-9A-F]+$")
set(_list "")
foreach(_id ${_equivalents})
  string(APPEND _list "\"${_id}\", ")
endforeach()
list(LENGTH _equivalents _n)

file(
  WRITE
  ${OUT}
  "// Generated by cmake/BuildIdentity.cmake.\n"
  "#include <array>\n"
  "namespace poseidon {\n"
  "inline constexpr const char *kPassIdentity = \"${_pass_id}\";\n"
  "inline constexpr const char *kAccuracyModelIdentity = \"${_accuracy_id}\";\n"
  "inline constexpr std::array<const char *, ${_n}> "
  "kAccuracyModelEquivalents = {${_list}};\n"
  "} // namespace poseidon\n")
